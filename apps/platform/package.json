{
  "name": "@template/platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "yarn workspace @template/db db:migrate && yarn build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/stylis-plugin-rtl": "^9.5.0",
    "@template/auth": "workspace:*",
    "@template/config": "workspace:*",
    "@template/db": "workspace:*",
    "@template/i18n": "workspace:*",
    "@template/ui": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "stylis": "^4.4.0",
    "zod": "^4.6.6"
