# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Tag Manager container (for example GTM-XXXX).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Database. DATABASE_URL wins over NEON_DATABASE_URL when both are set.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@YOUR_POOLER_HOST/neondb?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR_POOLER_HOST/neondb?sslmode=require

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
# AUTH_URL=http://localhost:3000
# AUTH_COOKIE_DOMAIN=.example.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional contact and verification email via Resend.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Web App <hello@example.com>
# CONTACT_TO_EMAIL=hello@example.com
# VERIFICATION_FROM_EMAIL=Web App <hello@example.com>
